# Copy to .env and fill in. Never commit .env (it is in .gitignore). Production values live in AWS SSM Parameter Store
# (docs/runbooks/production-setup.md); this file is for your laptop and staging.

# --- database (docker compose) ---
POSTGRES_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-runtime

# --- api ---
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Runtime role (row-level security applies). Never the owner/superuser.
DATABASE_URL=postgres://erp_app:change-me-runtime@db:5432/erp
# Owner role, used only by `migrate`.
MIGRATION_DATABASE_URL=postgres://postgres:change-me-owner@db:5432/erp
# Hops of proxies in front of the api: 1 = the web app (D76). 'false' only when nothing is in front.
TRUST_PROXY=1
# Required in production (sign-in links, invitations, alerts). Locally, leave empty: e-mails are logged, not sent.
SMTP_URL=
MAIL_FROM="GroPop <no-reply@example.com>"
# Owners sign in with an authenticator code (D83). Default: required in production, optional elsewhere.
# OWNER_TOTP=required

# --- files (S3). Locally docker-compose.override.yml provides a bucket; leave these empty. ---
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- encryption key for stored secrets: WooCommerce keys, owner authenticator codes, console codes ---
# Required in production. Generate once: openssl rand -base64 32   Losing it means reconnecting the shop and re-doing authenticator apps.
# WOO_ENC_KEY=
# WOO_ENC_KEY_PREVIOUS=        (only while rotating the key)
# Public https address that reaches the API through the web app, for WooCommerce webhooks, e.g. https://app.example.in/api
# WOO_WEBHOOK_BASE_URL=
APP_NAME=GroPop

# --- SaaS (B7). All optional: remove the # and fill in. An empty value is an error, so keep unused ones commented. ---
# BILLING_UPI_ID=
# BILLING_UPI_NAME=
# BILLING_GST_PERCENT=18       (only once you are registered for GST; ask your CA)
# SUPPORT_EMAIL=
# SUPPORT_WHATSAPP=
# PLATFORM_ALERT_EMAIL=

# --- web (build time) ---
API_URL=http://api:4000
