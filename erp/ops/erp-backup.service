# Copy to /etc/systemd/system/ with erp-backup.timer, then: systemctl daemon-reload && systemctl enable --now erp-backup.timer
[Unit]
Description=TRIDENT nightly database backup to the backup account
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/erp/backup.sh
